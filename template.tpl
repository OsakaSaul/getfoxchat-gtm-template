___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// GetFoxChat: loads the same widget the GetFoxChat snippet loads, with your Site ID on its address.
// The cache token makes it load once per page, however often the tag fires.
const injectScript = require('injectScript');
const encodeUriComponent = require('encodeUriComponent');

const url = 'https://getfoxchat.com/widget.js?site_id=' + encodeUriComponent(data.siteId);
injectScript(url, data.gtmOnSuccess, data.gtmOnFailure, 'getfoxchat-widget');


