___TESTS___

scenarios:
- name: Loads the GetFoxChat widget with the Site ID
  code: |-
    let injected = [];
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      injected.push({url: url, cacheToken: cacheToken});
      onSuccess();
    });
    runCode({siteId: '1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d'});
    assertThat(injected.length).isEqualTo(1);
    assertThat(injected[0].url).isEqualTo('https://getfoxchat.com/widget.js?site_id=1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d');
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: Uses one cache token so the widget loads once per page
  code: |-
    let tokens = [];
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      tokens.push(cacheToken);
      onSuccess();
    });
    runCode({siteId: '1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d'});
    runCode({siteId: '1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d'});
    assertThat(tokens.length).isEqualTo(2);
    assertThat(tokens[0]).isEqualTo('getfoxchat-widget');
    assertThat(tokens[1]).isEqualTo('getfoxchat-widget');
- name: Reports a failure when the widget cannot load
  code: |-
    mock('injectScript', (url, onSuccess, onFailure) => {
      onFailure();
    });
    runCode({siteId: '1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d'});
    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
- name: Encodes the Site ID into the address
  code: |-
    let injected = [];
    mock('injectScript', (url, onSuccess) => {
      injected.push(url);
      onSuccess();
    });
    runCode({siteId: 'a b&c'});
    assertThat(injected[0]).isEqualTo('https://getfoxchat.com/widget.js?site_id=a%20b%26c');
setup: ''


